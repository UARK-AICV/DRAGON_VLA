---
import { Picture as AstroPicture } from "astro:assets";
import { renderPDF } from "../lib/render-pdf";

interface Props {
  src: ImageMetadata | `${string}.pdf`;
  alt: string;
  priority?: boolean;
  invertInDarkMode?: boolean;
  /** Optional Tailwind class to constrain max height, e.g., "max-h-[24rem]" */
  maxHeightClass?: string;
}

const {
  src,
  alt,
  priority = false,
  invertInDarkMode = false,
  maxHeightClass,
} = Astro.props;

let image: ImageMetadata;

if (typeof src === "string") {
  image = await renderPDF(src);
} else {
  image = src;
}
---

<AstroPicture
  class={`w-full h-auto ${invertInDarkMode ? "dark:invert" : ""} ${maxHeightClass ?? ""}`}
  src={image}
  alt={alt}
  layout="constrained"
  formats={["avif"]}
  priority={priority}
  fit="scale-down"
/>
